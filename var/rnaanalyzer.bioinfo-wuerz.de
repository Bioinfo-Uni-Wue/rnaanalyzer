server {
    listen 80;
    server_name rnaanalyzer.bioinfo-wuerz.de;
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl;
    server_name rnaanalyzer.bioinfo-wuerz.de;

    ssl_certificate /etc/letsencrypt/live/rnaanalyzer.bioinfo-wuerz.de/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rnaanalyzer.bioinfo-wuerz.de/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers on;

    root /var/www/rnaanalyzer/htdocs;
    index index.html;

    # Serve CGI files
    location /cgi-bin/ {
         gzip off;
         root /var/www/rnaanalyzer;
         #fastcgi_pass unix:/var/run/fcgiwrap.socket;
         fastcgi_pass 127.0.0.1:9000;
         include /etc/nginx/fastcgi_params;
         #include fastcgi_params;
         fastcgi_param SCRIPT_FILENAME /var/www/rnaanalyzer$fastcgi_script_name;
         fastcgi_param SCRIPT_NAME $fastcgi_script_name;
         fastcgi_param DOCUMENT_ROOT /var/www/rnaanalyzer;
         autoindex on;
         allow all;
    }

    # Serve static files (HTML, CSS, JS, etc.)
    location / {
        try_files $uri $uri/ =404;
        autoindex on;
        allow all;
    }

    # Handle /tmp directory for temporary files
    location /tmp/ {
        alias /var/www/rnaanalyzer/tmp/;
        autoindex on;
        allow all;
    }

    # Increase FastCGI timeouts
    fastcgi_read_timeout 300;
    fastcgi_send_timeout 300;
}

