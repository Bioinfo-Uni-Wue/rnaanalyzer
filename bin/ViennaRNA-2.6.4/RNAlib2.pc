prefix=/mnt/c/Users/ama55id/Nextcloud/RNA_analyzer/rnaanalyzer/bin/ViennaRNA-2.6.4
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: ViennaRNA
Description: ViennaRNA Package 2 - Core library.
Version: 2.6.4
URL: https://www.tbi.univie.ac.at/RNA
Libs: -fno-lto -Wl,-fno-lto -L${libdir} -lRNA -fopenmp  -lpthread  -lstdc++
Libs.private: -lm
Cflags: -I${includedir} -I${includedir}/ViennaRNA    -pthread
